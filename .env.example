# FoodWise Pro v32 — secure local/cloud configuration
PORT=3000
LOCAL_MODE=true
LOCAL_USER_NAME=Local FoodWise User
LOCAL_LOGIN_EMAIL=local@foodwise.app
LOCAL_LOGIN_PASSWORD=foodwise123

# AI (optional on localhost)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
GEMINI_API_VERSION=v1beta
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4
CLOUDFLARE_SPEECH_MODEL=@cf/openai/whisper

# Cloud / Render mode — set all four values
LOCAL_MODE=false
MONGODB_URI=
MONGODB_DB_NAME=foodwise
SESSION_SECRET=
SESSION_MAX_DAYS=30
FIREBASE_API_KEY=
